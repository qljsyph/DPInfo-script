#!/bin/bash

RESET="\033[0m"
PURPLE="\033[1;35m"
BLUE="\033[1;34m"
GREEN="\033[1;32m"
YELLOW="\033[1;33m"
RED="\033[1;31m"
CYAN="\033[1;36m"

print_color() {
    local color="$1"
    shift
    printf '%b\n' "${color}$*${RESET}"
}

print_header() {
    print_color "${PURPLE}" "欢迎来到 私人服务 系统！"
    print_color "${BLUE}" "当前时间：$(date '+%Y-%m-%d %H:%M:%S')"
    print_color "${BLUE}" "系统内核版本：$(uname -r)"
    print_color "${BLUE}" "系统已运行：$(uptime -p)"
}

has_command() {
    command -v "$1" >/dev/null 2>&1
}

get_singbox_current_version() {
    local version
    version=$(sing-box version 2>/dev/null | head -n 1 | cut -d ' ' -f 3 || echo "未知版本")
    echo "${version#v}"
}

get_singbox_latest_version() {
    local version_type all_versions latest
    all_versions=$(curl -s https://api.github.com/repos/SagerNet/sing-box/releases | grep -oE '"tag_name":\s*"v[^"]+' | cut -d '"' -f 4)
    if [[ -z "$all_versions" ]]; then
        echo ""
        return 1
    fi

    version_type=$(echo "$1" | grep -oE '(alpha|beta|rc)' || echo "stable")
    if [[ "$version_type" == "stable" ]]; then
        latest=$(echo "$all_versions" | grep -vE '(alpha|beta|rc)' | head -n 1)
    else
        latest=$(echo "$all_versions" | grep -E "(alpha|beta|$version_type)" | head -n 1)
    fi
    echo "${latest#v}"
}

print_singbox_version_info() {
    if ! has_command sing-box; then
        print_color "${RED}" "未检测到 Sing-box 安装"
        return
    fi

    local current_version latest_version
    current_version=$(get_singbox_current_version)
    latest_version=$(get_singbox_latest_version "$current_version")

    if [[ -z "$latest_version" ]]; then
        print_color "${RED}" "无法获取 Sing-box 最新版本信息"
        exit 1
    fi

    print_color "${YELLOW}" "Sing-box 版本信息："
    print_color "${BLUE}" "当前版本：${RESET}${current_version} ${BLUE}最新版本：${RESET}${latest_version}"

    if [[ "$current_version" == "$latest_version" ]]; then
        print_color "${GREEN}" "Sing-box 已是最新版本"
    else
        print_color "${YELLOW}" "发现新版本！建议更新 Sing-box"
    fi
}

print_singbox_service_status() {
    if systemctl is-active sing-box >/dev/null 2>&1; then
        print_color "${GREEN}" "Sing-box 服务正在运行"
        local memory
        memory=$(ps -o rss= -C sing-box | awk '{total += $1} END {printf "%.2f", total/1024}')
        if [[ -n "$memory" ]]; then
            print_color "${BLUE}" "Sing-box 内存占用:${RESET} ${memory} MB"
        else
            print_color "${RED}" "无法获取 Sing-box 内存占用！"
        fi
    else
        print_color "${RED}" "Sing-box 服务未运行"
        print_color "${RED}" "Sing-box 未安装或不可用！"
    fi
}

print_nftables_singbox_status() {
    if systemctl list-units --type=service --all | grep -q "nftables-singbox.service"; then
        if systemctl is-enabled nftables-singbox.service >/dev/null 2>&1; then
            print_color "${CYAN}" "Nftables-singbox 自启动服务已启用"
        else
            print_color "${PURPLE}" "Nftables-singbox 自启动服务未启用"
        fi
    else
        print_color "${RED}" "Nftables-singbox 自启动服务未安装！"
    fi
}

print_nftables_status() {
    if has_command nft; then
        if systemctl is-active nftables >/dev/null 2>&1; then
            print_color "${CYAN}" "Nftables 防火墙已启用"
        else
            print_color "${PURPLE}" "Nftables 防火墙未运行"
        fi
    else
        print_color "${RED}" "Nftables 防火墙未安装！"
    fi
}

print_update_script_status() {
    local update_script="/etc/sing-box/update-singbox.sh"
    if [[ -f "$update_script" ]]; then
        if crontab -l 2>/dev/null | grep -q "$update_script"; then
            printf '%b' "${GREEN}自动更新配置文件已设置${RESET}"
            local interval
            interval=$(crontab -l 2>/dev/null | grep "$update_script" | grep -oE '\*/[0-9]+' | sed 's|\*/||')
            if [[ -n "$interval" ]]; then
                printf '%b%s%s' " ${CYAN}间隔：" "${RESET}" "${interval} 小时"
            else
                printf '%b' " ${RED}无法获取自动更新设定时间！${RESET}"
                printf '%b' " ${CYAN}Crontab 条目：${RESET}"
                crontab -l 2>/dev/null | grep "$update_script"
            fi
        else
            printf '%b' "${RED}自动更新配置文件未设置！${RESET}"
        fi

        local last_update
        last_update=$(stat -c %y "$update_script" 2>/dev/null | cut -d'.' -f1)
        if [[ -n "$last_update" ]]; then
            printf '%b\n' " ${CYAN}上次更新时间：${RESET}${last_update}"
        else
            printf '%b\n' " ${RED}无法获取上次更新时间！${RESET}"
        fi
    else
        print_color "${RED}" "自动更新配置文件不存在！"
    fi
}

print_cpu_usage() {
    local cpu idle
    cpu=$(grep 'cpu ' /proc/stat | awk '{usage=($2+$4)*100/($2+$4+$5); printf "%.2f", usage}')
    idle=$(echo "100 - $cpu" | bc)
    print_color "${YELLOW}" "CPU 使用率：${RESET}${cpu}%, 空闲: ${idle}%"
}

print_memory_usage() {
    local total free used percent
    total=$(awk '/MemTotal/ {print $2}' /proc/meminfo)
    free=$(awk '/MemAvailable/ {print $2}' /proc/meminfo)
    used=$((total - free))
    percent=$(awk -v used="$used" -v total="$total" 'BEGIN {printf "%.2f", (used/total)*100}')
    print_color "${YELLOW}" "当前内存使用情况：${RESET}$((used / 1024))/$((total / 1024)) MB (${percent}%)"
}

print_disk_usage() {
    local usage
    usage=$(df -h / 2>/dev/null | awk 'NR==2 {print $5}')
    print_color "${YELLOW}" "当前磁盘使用情况：${RESET}${usage}"
}

get_dns_servers() {
    local source_file="/etc/resolv.conf"
    if [[ -f /run/systemd/resolve/resolv.conf ]]; then
        source_file="/run/systemd/resolve/resolv.conf"
    fi
    grep '^nameserver' "$source_file" | awk '{print $2}'
}

print_dns_info() {
    local servers
    servers=$(get_dns_servers)
    printf '%b' "${YELLOW}DNS 服务器地址:${RESET} "
    if [[ -n "$servers" ]]; then
        while IFS= read -r dns; do
            printf "  %s" "$dns"
        done <<< "$servers"
        printf '\n'
    else
        print_color "${RED}" "未找到 DNS 服务器信息！"
    fi
}

print_gateway_info() {
    local gateway iface
    gateway=$(ip route | awk '/default/ {print $3}')
    iface=$(ip route | awk '/default/ {print $5}')

    printf '%b%s%b ' "${YELLOW}" "默认网关:" "${RESET}"
    if [[ -n "$gateway" ]]; then
        printf "%s\n" "$gateway"
    else
        print_color "${RED}" "未找到默认网关信息！"
    fi

    printf '%b%s%b ' "${YELLOW}" "网关接口:" "${RESET}"
    if [[ -n "$iface" ]]; then
        printf "%s\n" "$iface"
    else
        print_color "${RED}" "未找到网关接口信息！"
    fi
}

get_wan_ip() {
    local wan_ip api
    local apis=(
        "https://ifconfig.me"
        "https://api.ipify.org"
        "https://ip.sb"
        "https://icanhazip.com"
    )

    has_command curl || return

    for api in "${apis[@]}"; do
        wan_ip=$(curl -4 -s --max-time 3 "$api" 2>/dev/null | tr -d '[:space:]')
        if [[ "$wan_ip" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
            echo "$wan_ip"
            return
        fi
    done
}

print_wan_ip() {
    local wan_ip
    wan_ip=$(get_wan_ip)
    print_color "${BLUE}" "  落地IP    : ${wan_ip:-N/A}"
}

print_network_interfaces() {
    local interface mac ip dhcp
    print_color "${BLUE}" "网络接口信息："
    while IFS= read -r interface; do
        [[ "$interface" =~ ^(lo|docker0|br-|veth|tun|tap|wg|tailscale|zt) ]] && continue
        mac=$(cat /sys/class/net/"$interface"/address 2>/dev/null)
        ip=$(ip -o -4 addr show "$interface" | awk '{print $4}' | cut -d'/' -f1)
        if grep -qE "iface[[:space:]]+${interface}[[:space:]]+inet[[:space:]]+dhcp" /etc/network/interfaces /etc/network/interfaces.d/* 2>/dev/null; then
            dhcp="DHCP 分配"
        else
            dhcp="静态 IP"
        fi
        print_color "${YELLOW}" "接口:${RESET} $interface"
        print_color "${BLUE}" "  MAC 地址:${RESET} ${mac:-未知}"
        print_color "${BLUE}" "  IP 地址:${RESET} ${ip:-未分配}"
        print_color "${BLUE}" "  IP 类型:${RESET} ${dhcp}"
    done < <(ip -o link show | awk -F': ' '{print $2}' | cut -d'@' -f1)
}

main() {
    print_header
    print_singbox_version_info
    print_singbox_service_status
    print_nftables_singbox_status
    print_nftables_status
    print_update_script_status

    export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
    export TERM=xterm

    print_cpu_usage
    print_memory_usage
    print_disk_usage
    print_dns_info
    print_gateway_info
    print_wan_ip
    print_network_interfaces
}

main
